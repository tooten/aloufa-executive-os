# Copier dans .env.local en local, ou saisir dans les réglages Vercel. Ne jamais commiter les vraies valeurs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Côté serveur uniquement : clé secrète Supabase et sel du hachage des e-mails clients (32 caractères aléatoires ou plus)
SUPABASE_SECRET_KEY=
IMPORT_HASH_SALT=
# Fuseau de la boutique : les heures sans fuseau des exports sont lues dans ce fuseau
STORE_TIME_ZONE=America/New_York
# Dirigeants : connexion Postgres directe (Supabase > Connect > Transaction pooler), clé API Claude, secret des tâches planifiées
DATABASE_URL=
ANTHROPIC_API_KEY=
CRON_SECRET=
AGENT_MODEL=claude-sonnet-5-5
# Plafond de dépense des dirigeants sur 7 glissants (USD) et par run. Le plafond mensuel se règle aussi dans la console Anthropic.
WEEKLY_BUDGET_USD=3
MAX_COST_PER_RUN_USD=0.5
